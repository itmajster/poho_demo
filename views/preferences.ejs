<!-- views/preferences.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coffee Preferences</title>
    <link rel="stylesheet" type="text/css" href="/css/preferences.css">
    <link href='https://fonts.googleapis.com/css?family=Quicksand' rel='stylesheet'>
    <script src="/js/preferences.js" defer></script>


</head>
<body>
    <div class="container">

        <div class="top-label">
            <button class="button-back" id="button-back">
                <svg class="w-[45px] h-[45px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12l4-4m-4 4 4 4"/>
                </svg>                          
            </button>

            <!-- Progress bar -->
            <div class="progress-bar">
                <div class="progress-step" id="progress-step-1">Príprava</div>
                <div class="progress-step" id="progress-step-2">Praženie</div>
                <div class="progress-step" id="progress-step-3">Tvoja skúsenosť</div>
                <div class="progress-step" id="progress-step-4">Chuťový profil</div>
                <div class="progress-step" id="progress-step-5">Pôvod</div>
            </div>

            
            <button class="button-close" id="button-close">
                <svg class="w-[45px] h-[45px] text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18 17.94 6M18 18 6.06 6"/>
                </svg>                          
            </button>
            
        </div>
        
        <form data-multi-step class="multi-step-form" action="/preferences" method="POST">

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <h2 class="title">Ako si pripravuješ svoju kávu?</h2>
                        </div>
                        
                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="brewingMethod" id="brewingMethod" value="espresso" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Espresso</div>
                            </label>

                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="brewingMethod" id="brewingMethod" value="filter" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Filtrovaná káva</div>
                            </label>

                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="brewingMethod" id="brewingMethod" value="pods" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Kapsule</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="button" class="click-next" id="button-next" role="button" >Pokračuj</button>
                        </div>
                        
                    </div>
                        
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <h2 class="title">Aký stupeň praženia uprednostníš?</h2>
                            <a href="/" class="close"></a>
                        </div>

                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="roastLevel" id="roastLevel" value="light" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Svetlé</div>
                            </label>

                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="roastLevel" id="roastLevel" value="medium" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Stredné</div>
                            </label>

                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="roastLevel" id="roastLevel" value="dark" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Tmavé</div>
                            </label>

                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="roastLevel" id="roastLevel" value="random" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Je mi to jedno</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="button" class="click-next" id="button-next" role="button" >Pokračuj</button>
                        </div>
                        
                    </div>
                        
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <h2 class="title">Pochvaľ sa ako sa vyznáš v káve.</h2>
                            <a href="/" class="close"></a>
                        </div>
                        
                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="coffeeExperienceLevel" id="coffeeExperienceLevel" value="newbie" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Nováčik</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="coffeeExperienceLevel" id="coffeeExperienceLevel" value="intermediate" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Niečo už ovládam</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="coffeeExperienceLevel" id="coffeeExperienceLevel" value="advanced" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Pokročilý</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="coffeeExperienceLevel" id="coffeeExperienceLevel" value="nerd" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Nerd</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="button" class="click-next" id="button-next" role="button" >Pokračuj</button>
                        </div>
                
                    </div>
                
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <div>
                                <h2 class="title">Aké chute máš najradšej? Alebo radšej objavuješ?</h2>
                            </div>
                            <a href="/" class="close"></a>
                        </div>

                        <div class="options">
                            <label class="rad-label">
                                <input type="checkbox" class="rad-input" name="flavorProfile" id="flavorProfile" value="bitter" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Horkú ako život sám</div>
                            </label>
                            <label class="rad-label">
                                <input type="checkbox" class="rad-input" name="flavorProfile" id="flavorProfile" value="fruity" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Ovocie, ovocie a ovocie</div>
                            </label>
                            <label class="rad-label">
                                <input type="checkbox" class="rad-input" name="flavorProfile" id="flavorProfile" value="sweet" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Sladké ako čokoláda</div>
                            </label>
                            <label class="rad-label">
                                <input type="checkbox" class="rad-input" name="flavorProfile" id="flavorProfile" value="acid" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Hlavne nech je to kyslé</div>
                            </label>
                            <label class="rad-label">
                                <input type="checkbox" class="rad-input" name="flavorProfile" id="flavorProfile" value="random" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Prekvap ma, chcem experimentovať</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="button" class="click-next" id="button-next" role="button" >Pokračuj</button>
                        </div>  
                    </div>
                
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <div>
                                <h2 class="title">Na pôvode kávy záleži.</h2>
                            </div>
                            <a href="/" class="close"></a>
                        </div>
                
                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="origin" id="origin" value="africa" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Afrika</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="origin" id="origin" value="south america" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Južná amerika</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="origin" id="origin" value="central america" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Stredná amerika</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="origin" id="origin" value="asia" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Ázia</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="origin" id="origin" value="random" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Necham sa prekvapiť</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="button" class="click-next" id="button-next" role="button" >Pokračuj</button>
                        </div> 
                    </div>
                
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            <div class="card" data-step>
                <div class="main-content">
                    <div class="main-card">
                        <div class="head-title">
                            <h2 class="title">Posledná dôležitá vec: kofeín.</h2>
                            <a href="/" class="close"></a>
                        </div>
                        
                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="caffeine" id="caffeine" value="regular" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Regular</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="caffeine" id="caffeine" value="decaf" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Decaf</div>
                            </label>
                        </div>

                        <h3 class="title">Aké zrná si praješ doručiť?</h3>
                        <div class="options">
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="grinding" id="grinding" value="beans" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Celé zrná</div>
                            </label>
                            <label class="rad-label">
                                <input type="radio" class="rad-input" name="grinding" id="grinding" value="grinded" data-next>
                                <div class="rad-design"></div>
                                <div class="rad-text">Pomleté zrná</div>
                            </label>
                        </div>

                        <div class="buttons">
                            <button type="submit" class="click-next" id="button-next" >Moja Zhoda</button>
                        </div>     
                    </div>
                
                    <div class="card-image-div">
                        <img src="/images/img1.jpg" class="card-image">
                    </div>
                </div>
            </div>

            
        </form>
    </div>

</body>
</html>