<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Coffee Subscription Service</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
            margin: 0;
            padding: 0;
            min-height: 100vh;
            background-image: url('https://www.roastycoffee.com/wp-content/uploads/devin-avery-rwwMB7kTNes-unsplash-scaled.jpg');
            background-size: cover;
            background-position: center;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .container {
            text-align: center;
            background-color: rgba(255, 255, 255, 0.8);
            padding: 5%;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            max-width: 90%;
            width: 100%;
        }

        h1 {
            margin-top: 0;
            font-size: clamp(24px, 5vw, 36px);
            color: #333;
        }

        p {
            font-size: clamp(16px, 3vw, 18px);
            color: #748397;
            margin-bottom: 20px;
        }

        .buttons-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
        }

        .btn {
            padding: 10px 20px;
            margin: 10px;
            font-size: clamp(14px, 2vw, 16px);
            color: #fff;
            background-color: #B22E5B;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
        }

        @media (max-width: 480px) {
            .container {
                padding: 10%;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>Welcome to the Coffee Subscription Service!</h1>
        <p>Discover your perfect coffee!</p>
        
        <div class="buttons-container">
            <a href="/preferences" class="btn">Get Started</a>
            <a href="/roasteries" class="btn">Roasteries</a>
        </div>
    </div>
</body>
</html>